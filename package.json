{
  "name": "fast-art-cms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:prod",
    "build:prod": "vue-tsc -b && vite build --mode production",
    "build:dev": "vue-tsc -b && vite build --mode development",
    "preview": "vite preview",
    "lint": "oxlint src --fix-suggestions",
    "format": "oxfmt src",
    "commit": "NODE_OPTIONS='--experimental-transform-types' git-cz",
    "commitlint": "commitlint --edit",
    "release": "standard-version",
    "release:dry": "standard-version --dry-run",
    "release:first": "standard-version --first-release",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@vueuse/core": "^14.1.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.2",
    "unocss-merge": "^0.8.2",
    "vtip-edit": "^0.0.2",
    "vue": "^3.5.24",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@types/node": "^24.10.1",
    "@vicons/tabler": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "naive-ui": "^2.43.2",
    "oxfmt": "^0.17.0",
    "oxlint": "^1.32.0",
    "standard-version": "^9.5.0",
    "typescript": "~5.9.3",
    "unocss": "^66.5.10",
    "vite": "npm:rolldown-vite@7.2.5",
    "vue-tsc": "^3.1.4"
  },
  "lint-staged": {
    "*.{vue,ts,mts,cts,js,cjs,mjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix-suggestions"
    ],
    "*.{json,md,css,html}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.5"
    }
  }
}
